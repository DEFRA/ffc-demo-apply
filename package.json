{
  "name": "ffc-demo-apply",
  "description": "Digital service mock to claim public money in the event property subsides into mine shaft.",
  "version": "2.3.5",
  "homepage": "https://github.com/DEFRA/mine-support-claim-service",
  "main": "app/index.js",
  "scripts": {
    "pretest": "npm run test:lint",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:lint": "standard",
    "test:lint-fix": "standard --fix",
    "test:pact": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=test/contract --coverage=false",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathPatterns=test/integration --coverage=false",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage=false --onlyChanged --watch --runInBand",
    "test:debug": "node --experimental-vm-modules --inspect-brk=0.0.0.0 ./node_modules/jest/bin/jest.js --coverage=false --onlyChanged --watch --runInBand --no-cache",
    "test:unit": "PORT=0 node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=test/unit",
    "test:unit-watch": "PORT=0 node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPatterns=test/unit --coverage=false --onlyChanged --watch",
    "start:watch": "nodemon --inspect=0.0.0.0 --ext js --legacy-watch app/index.js"
  },
  "author": "Defra DDTS",
  "contributors": [
    "John Watson <john.watson2@rpa.gov.uk>"
  ],
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@azure/identity": "^4.4.1",
    "@azure/monitor-opentelemetry": "^1.18.1",
    "@hapi/hapi": "^21.3.10",
    "ffc-messaging": "^2.10.6",
    "hapi-pino": "^13.0.0",
    "joi": "^18.2.1",
    "notifications-node-client": "8.2.1",
    "pg": "8.13.1",
    "pg-hstore": "2.3.4",
    "sequelize": "^6.37.8",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^16.0.1",
    "jest": "30.5.2",
    "jest-junit": "^17.0.0",
    "nodemon": "3.1.4",
    "sequelize-mock": "0.10.2",
    "standard": "^17.1.2"
  },
  "standard": {
    "globals": [
      "describe",
      "beforeEach",
      "expect",
      "test",
      "afterEach",
      "jest",
      "beforeAll",
      "afterAll"
    ]
  },
  "nodemonConfig": {
    "ignore": [
      "test-output/**"
    ]
  },
  "overrides": {
    "sequelize": {
      "uuid": "^11.1.1"
    },
    "@azure/monitor-opentelemetry": {
      "@opentelemetry/instrumentation-http": "0.222.0"
    },
    "jest-config": {
      "glob": "14.0.2"
    },
    "jest-runtime": {
      "glob": "14.0.2"
    },
    "@jest/reporters": {
      "glob": "14.0.2"
    },
    "test-exclude": {
      "glob": "14.0.2",
      "minimatch": "11.0.8"
    }
  }
}
